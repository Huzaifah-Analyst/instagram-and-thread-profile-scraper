# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
# Only ignore an ad-hoc spec PyInstaller drops at the repo root; the real
# packaging spec (TSK-501) lives at config/metainspector.spec and is tracked.
/*.spec

# Virtual Environments
venv/
env/
ENV/
.venv/

# Playwright & Browser Sessions (CRITICAL SECURITY: NEVER COMMIT)
browser_profile/
**/browser_profile/
checker_profiles/
checkers.json
checkers.tmp
*.session
cookies.json
tokens.json

# Local Databases, Caches & Logs
*.db
*.sqlite
logs/
debug/
**/debug/
.pytest_cache/
.pytest-local-temp*/
.pytest-local-round3*/
.test-tcl/
/docs/accounts.txt
/docs/testinusername.txt

# Sensitive Configuration
.env
config_local.py

# Client Data & Results
usernames.txt
**/usernames.txt
results/
**/results/
*.csv
*.xlsx

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Per-account benchmark exports remain local; publish aggregate metrics only.
/docs/implementation/evidence/round4-benchmark95-rows.tsv
/docs/implementation/evidence/round4-platform-timings.tsv

# Local output preferences
output_settings.json
output_settings.tmp
